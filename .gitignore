# What this repository's own tools write, and nothing else (#229): a pattern
# here names a path something in this repo can produce. Each platform folder
# under frontend/ (android, ios, linux, macos, windows) keeps the .gitignore
# `flutter create` gave it, which covers that platform's build state; this file
# covers the rest.

# --- Secrets and per-machine settings ----------------------------------------
# Every service's settings; `make env` seeds it. .env.example is the template.
.env
# The Cloudflare/Google credentials; terraform.tfvars.example is the template.
terraform.tfvars
# Claude Code: the dev-login bearer (`make claude-token`) and this machine's
# permission grants.
.claude/token
.claude/settings.local.json

# --- Backend (Python) ---------------------------------------------------------
# The gates run with PYTHONDONTWRITEBYTECODE and `-p no:cacheprovider`, but a
# bare `python`/`pytest` (CI, or by hand) writes both.
__pycache__/
*.py[cod]
.pytest_cache/
# `ruff check` / `ruff format` (make back-lint).
.ruff_cache/
# pytest.ini's addopts write coverage whenever pytest runs without the
# Makefile's `-o addopts=""`.
.coverage
coverage.xml
htmlcov/
# Nothing needs a venv (every tool runs in the backend image), but one may exist.
.venv/

# --- Frontend (Flutter) -------------------------------------------------------
# No blanket *.lock (#192): frontend/pubspec.lock is committed, because an
# application pins what it resolved - only a published package leaves it out.
.dart_tool/
.flutter-plugins-dependencies
frontend/build/
# `flutter test --coverage`.
frontend/coverage/
# Regenerated from the ARB files by `flutter pub get` and `make gen-l10n`.
frontend/lib/l10n/generated/
# Plugin registrants `flutter pub get` rewrites on every run. Android's and
# iOS's are covered by their own platform .gitignore.
frontend/linux/flutter/generated_plugin*
frontend/windows/flutter/generated_plugin*
frontend/macos/Flutter/GeneratedPluginRegistrant.swift

# --- Terraform ----------------------------------------------------------------
# State (and its backups and lock) holds secrets in plain text, and lives only
# on the machine that applies it.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# --- Local tooling output -----------------------------------------------------
# Headless screenshots (make shot).
shots/
# The deploy timer's state: the live commit, a failed one, its lock (#105).
.deploy/
# Crash logs: Flutter's flutter_NN.log, Terraform's crash.log.
*.log

# --- Editors ------------------------------------------------------------------
# IntelliJ / Android Studio per-machine project files, VS Code, vim.
.idea/
*.iml
.vscode/
*.swp
